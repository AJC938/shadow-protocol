extends Node
## Autoload "AudioManager" — buses, music, ambience, UI, voice and one-shot 3D sounds.
## Sound names map to files through SoundLibrary (generated by tools/gen_audio.py).

signal voice_line(speaker: String, text: String, duration: float)

const BUSES := ["Music", "SFX", "Ambience", "Voice", "UI"]

var _cache: Dictionary = {}
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_current: AudioStreamPlayer
var _music_name: StringName = &""
var _ambience: AudioStreamPlayer
var _ui: AudioStreamPlayer
var _voice: AudioStreamPlayer
var _voice_queue: Array = []
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_rng.randomize()
	_create_buses()
	_music_a = _make_player("Music")
	_music_b = _make_player("Music")
	_music_current = _music_a
	_ambience = _make_player("Ambience")
	_ui = _make_player("UI")
	_voice = _make_player("Voice")
	for p in [_music_a, _music_b, _ambience]:
		p.finished.connect(_on_loop_finished.bind(p))
	_voice.finished.connect(_play_next_voice)


func _create_buses() -> void:
	for b in BUSES:
		if AudioServer.get_bus_index(b) == -1:
			AudioServer.add_bus()
			var idx := AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, b)
			AudioServer.set_bus_send(idx, "Master")
	# Voice gets a subtle radio band-pass / compression feel.
	var vi := AudioServer.get_bus_index("Voice")
	if AudioServer.get_bus_effect_count(vi) == 0:
		var comp := AudioEffectCompressor.new()
		comp.threshold = -16.0
		comp.ratio = 3.0
		AudioServer.add_bus_effect(vi, comp)
	var si := AudioServer.get_bus_index("SFX")
	if AudioServer.get_bus_effect_count(si) == 0:
		var lim := AudioEffectLimiter.new()
		lim.ceiling_db = -0.5
		AudioServer.add_bus_effect(si, lim)


func _make_player(bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	add_child(p)
	return p


func _on_loop_finished(p: AudioStreamPlayer) -> void:
	if p == _music_current and _music_name != &"":
		p.play()
	elif p == _ambience and p.stream:
		p.play()


# --------------------------------------------------------------------------- streams

func has_sound(sound: StringName) -> bool:
	return SoundLibrary.SOUNDS.has(String(sound))


func get_stream(sound: StringName) -> AudioStream:
	var key := String(sound)
	if not SoundLibrary.SOUNDS.has(key):
		return null
	var files: Array = SoundLibrary.SOUNDS[key]
	if files.is_empty():
		return null
	var path: String = files[_rng.randi() % files.size()]
	if not _cache.has(path):
		if not ResourceLoader.exists(path):
			push_warning("AudioManager: missing %s" % path)
			_cache[path] = null
		else:
			_cache[path] = load(path)
	return _cache[path]


# --------------------------------------------------------------------------- music / ambience

func play_music(sound: StringName, fade: float = 1.5) -> void:
	if sound == _music_name and _music_current.playing:
		return
	var stream := get_stream(sound)
	var old := _music_current
	var nxt := _music_b if old == _music_a else _music_a
	_music_name = sound
	if stream:
		nxt.stream = stream
		nxt.volume_db = -40.0
		nxt.play()
		create_tween().tween_property(nxt, "volume_db", 0.0, fade)
	_music_current = nxt
	if old.playing:
		var t := create_tween()
		t.tween_property(old, "volume_db", -40.0, fade)
		t.tween_callback(old.stop)


func stop_music(fade: float = 1.5) -> void:
	_music_name = &""
	var p := _music_current
	if p.playing:
		var t := create_tween()
		t.tween_property(p, "volume_db", -40.0, fade)
		t.tween_callback(p.stop)


func play_ambience(sound: StringName, volume_db: float = -6.0) -> void:
	var s := get_stream(sound)
	_ambience.stream = s
	_ambience.volume_db = volume_db
	if s:
		_ambience.play()


func stop_ambience() -> void:
	_ambience.stop()
	_ambience.stream = null


# --------------------------------------------------------------------------- one-shots

func play_ui(sound: StringName) -> void:
	var s := get_stream(sound)
	if s:
		_ui.stream = s
		_ui.play()


func play_2d(sound: StringName, volume_db: float = 0.0, bus: String = "SFX", pitch: float = 1.0) -> AudioStreamPlayer:
	var s := get_stream(sound)
	if s == null:
		return null
	var p := AudioStreamPlayer.new()
	p.stream = s
	p.bus = bus
	p.volume_db = volume_db
	p.pitch_scale = pitch
	add_child(p)
	p.finished.connect(p.queue_free)
	p.play()
	return p


func play_3d(sound: StringName, pos: Vector3, volume_db: float = 0.0, max_distance: float = 45.0, pitch_variance: float = 0.06, bus: String = "SFX") -> AudioStreamPlayer3D:
	var s := get_stream(sound)
	var scene := get_tree().current_scene
	if s == null or scene == null:
		return null
	var p := AudioStreamPlayer3D.new()
	p.stream = s
	p.bus = bus
	p.volume_db = volume_db
	p.max_distance = max_distance
	p.unit_size = 6.0
	p.attenuation_filter_cutoff_hz = 6000.0
	p.pitch_scale = 1.0 + _rng.randf_range(-pitch_variance, pitch_variance)
	scene.add_child(p)
	p.global_position = pos
	p.finished.connect(p.queue_free)
	p.play()
	return p


# --------------------------------------------------------------------------- voice

## Queues a radio/voice line. Subtitles are emitted through `voice_line`.
func play_voice(sound: StringName, speaker: String, text: String, interrupt: bool = false) -> void:
	if interrupt:
		_voice_queue.clear()
		_voice.stop()
	_voice_queue.append([sound, speaker, text])
	if not _voice.playing:
		_play_next_voice()


func clear_voice() -> void:
	_voice_queue.clear()
	_voice.stop()


func is_voice_playing() -> bool:
	return _voice.playing or not _voice_queue.is_empty()


func _play_next_voice() -> void:
	if _voice_queue.is_empty():
		return
	var item: Array = _voice_queue.pop_front()
	var s := get_stream(item[0])
	var dur := 3.0
	if s:
		_voice.stream = s
		_voice.play()
		dur = s.get_length()
	else:
		# Missing audio: keep the subtitle on screen and continue the queue.
		get_tree().create_timer(dur).timeout.connect(_play_next_voice)
	voice_line.emit(item[1], item[2], dur)
