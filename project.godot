; Engine configuration file.
; SHADOW PROTOCOL — Godot 4.7.2 Standard (GDScript)

config_version=5

[application]

config/name="SHADOW PROTOCOL"
config/description="Third-person tactical stealth campaign."
config/version="2.0.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
InputRouter="*res://scripts/input/input_router.gd"
ControllerBridge="*res://scripts/input/controller_bridge.gd"
SaveSystem="*res://scripts/save/save_system.gd"
SoundEvents="*res://scripts/stealth/sound_events.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="interactable"
3d_physics/layer_5="doors"
3d_physics/layer_6="glass"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
textures/vram_compression/import_etc2_astc=false
