[resource]
script = ExtResource("2_u0ubc")
id = "m03"
number = 3
title = "Final Extraction"
codename = "FINAL EXTRACTION"
location = "Kestrel Ridge Facility — Command Sector"
background = "Elias Voss, Northgate's head of security, built BLACK SIGNAL from inside the company. The final evidence — the buyer ledger — sits in the command sector vault. With it, the network and everyone who paid for it can be exposed."
briefing = "This is the last run. Get through the blast doors into the restricted command area, then shut down the main security network from the research lab's network core — that unlocks the command sector.

Voss is on site with his heavy response team. Fight him, or seal him inside the strategy room with the lockdown override — either way he cannot be allowed to stop you. Take the ledger from the vault and get to the helipad. I'll have a bird waiting."
objectives = Array[ExtResource("1_ink8e")]([SubResource("Resource_rg6eq"), SubResource("Resource_bo5ee"), SubResource("Resource_6kabp"), SubResource("Resource_xgoax"), SubResource("Resource_lu6f3"), SubResource("Resource_e0j1f"), SubResource("Resource_ptalt"), SubResource("Resource_26jng"), SubResource("Resource_l8c0v")])
weapons = Array[StringName]([&"pistol", &"rifle", &"shotgun"])
gadgets = Array[StringName]([&"disruptor", &"scanner", &"recon"])
scene_path = "res://scenes/missions/mission_03.tscn"
par_time = 1080.0
music = &"mission_3"
briefing_voice = &"vo_brief_m03"
