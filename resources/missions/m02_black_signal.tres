[resource]
script = ExtResource("2_vxs0o")
id = "m02"
number = 2
title = "Black Signal"
codename = "BLACK SIGNAL"
location = "Kestrel Ridge Facility — Communications Sector"
background = "The Silent Entry package contained relay schedules for a network codenamed BLACK SIGNAL: hidden transmitters inside Northgate's own security grid, used to intercept allied communications and sell them to the highest bidder."
briefing = "The communications sector is wired tight — cameras in every corridor, and security specialists who will run for an alarm panel the moment they see you. Find the security control room and take their surveillance relays offline, then pull the classified communication files from the server hall.

Downloading those files will trip a network lockdown. When it does, survive until the uplink completes, then get to the roof. Use the service ducts, use the disruptor — and remember that specialists carry radios."
objectives = Array[ExtResource("1_a880g")]([SubResource("Resource_6scck"), SubResource("Resource_4wcvy"), SubResource("Resource_13tfd"), SubResource("Resource_qwykw"), SubResource("Resource_5anry"), SubResource("Resource_2rc7n"), SubResource("Resource_pj7rc"), SubResource("Resource_vqhf1")])
weapons = Array[StringName]([&"pistol", &"rifle", &"shotgun"])
gadgets = Array[StringName]([&"disruptor", &"scanner", &"recon"])
scene_path = "res://scenes/missions/mission_02.tscn"
par_time = 900.0
music = &"mission_2"
briefing_voice = &"vo_brief_m02"
debrief = "The files confirm it. BLACK SIGNAL is run from the command sector by the facility's own security commander, Elias Voss. He is selling our people, GHOST. One more night."
